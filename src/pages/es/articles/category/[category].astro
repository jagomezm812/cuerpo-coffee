---
import Base from '../../../../layouts/Base.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import { getPublishedArticles, getArticlesIndexHref } from '../../../../lib/articles';

export async function getStaticPaths() {
  const CATEGORIES = ['troubleshooting', 'fundamentals', 'gear', 'methods', 'sourcing'] as const;
  const articles = await getPublishedArticles('es');
  return CATEGORIES.map((category) => ({
    params: { category },
    props: {
      articles: articles.filter((a) => a.data.category === category),
    },
  }));
}

const { category } = Astro.params;
const { articles } = Astro.props;
---

<Base
  title={`${category} — Articles`}
  description={`Cuerpo Coffee articles about ${category}, in Spanish.`}
  lang="es"
>
  <section class="container category-page">
    <header class="category-page__header">
      <p class="category-page__eyebrow"><a href={getArticlesIndexHref('es')}>All articles</a></p>
      <h1>{category}</h1>
    </header>

    {
      articles.length > 0 ? (
        <div class="category-page__list">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <p>No articles here yet.</p>
      )
    }
  </section>
</Base>

<style>
  .category-page {
    padding-block: var(--space-8);
    max-width: 56rem;
    margin-inline: auto;
  }

  .category-page__header {
    margin-bottom: var(--space-6);
  }

  .category-page__eyebrow {
    margin-bottom: var(--space-3);
  }

  .category-page__eyebrow a {
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
  }

  .category-page h1 {
    text-transform: capitalize;
  }
</style>
