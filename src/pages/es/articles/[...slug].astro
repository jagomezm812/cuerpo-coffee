---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import ReflectionArticle from '../../../layouts/ReflectionArticle.astro';
import { getPublishedArticles } from '../../../lib/articles';
import { getSeriesGroupForArticle } from '../../../lib/series';
import { getAuthor } from '../../../lib/author';

export async function getStaticPaths() {
  const articles = await getPublishedArticles('es');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const isReflection = article.data.category === 'reflection';

const allArticles = await getPublishedArticles('es');
const author = await getAuthor();
const wordCount = (article.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingTimeMinutes = Math.max(1, Math.round(wordCount / 200));
// Reflection essays don't use a series rail (see ReflectionArticle.astro),
// so there's no need to look one up for them.
const seriesGroup = isReflection ? undefined : await getSeriesGroupForArticle(article);
---

{
  isReflection ? (
    // Same branch as the English route file — see
    // src/pages/articles/[...slug].astro for the reasoning. No Spanish
    // reflection essay exists yet, so this path is untested against real
    // content, but the route tree stays symmetric with the English one on
    // principle, same as every other route pair in this codebase.
    <ReflectionArticle
      article={article}
      readingTimeMinutes={readingTimeMinutes}
      relatedEssays={allArticles.filter((a) => a.id !== article.id && a.data.category === 'reflection').slice(0, 3)}
      author={author.data}
    >
      <Content />
    </ReflectionArticle>
  ) : (
    <Article
      article={article}
      readingTimeMinutes={readingTimeMinutes}
      relatedArticles={[
        ...allArticles.filter((a) => a.id !== article.id && a.data.category === article.data.category),
        ...allArticles.filter((a) => a.id !== article.id && a.data.category !== article.data.category),
      ].slice(0, 3)}
      headings={headings}
      seriesGroup={seriesGroup}
      author={author.data}
    >
      <Content />
    </Article>
  )
}
