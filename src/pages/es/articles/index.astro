---
import Base from '../../../layouts/Base.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getPublishedArticles, getCategoryHref } from '../../../lib/articles';

const categories = ['troubleshooting', 'fundamentals', 'gear', 'methods', 'sourcing'] as const;
const articles = await getPublishedArticles('es');
---

<Base
  title="Articles"
  description="Every Cuerpo Coffee article available in Spanish, newest first."
  lang="es"
>
  <section class="container articles-page">
    <header class="articles-page__header">
      <h1>Articles</h1>
      <nav aria-label="Filter by category" class="articles-page__filters">
        {
          categories.map((category) => (
            <a href={getCategoryHref('es', category)}>{category}</a>
          ))
        }
      </nav>
    </header>

    {
      articles.length > 0 ? (
        <div class="articles-page__list">
          {articles.map((article) => <ArticleCard article={article} />)}
        </div>
      ) : (
        <p>Translated articles are on the way — check back soon.</p>
      )
    }
  </section>
</Base>

<style>
  .articles-page {
    padding-block: var(--space-8);
    max-width: 56rem;
    margin-inline: auto;
  }

  .articles-page__header {
    margin-bottom: var(--space-6);
  }

  .articles-page__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .articles-page__filters a {
    text-transform: capitalize;
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
  }

  .articles-page__filters a:hover {
    color: var(--copper);
  }
</style>
