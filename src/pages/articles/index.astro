---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const categories = ['troubleshooting', 'fundamentals', 'gear', 'methods', 'sourcing'] as const;

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<Base title="Articles" description="Every Cuerpo Coffee article, newest first.">
  <section class="container articles-page">
    <header class="articles-page__header">
      <h1>Articles</h1>
      <nav aria-label="Filter by category" class="articles-page__filters">
        {
          categories.map((category) => (
            <a href={`/articles/category/${category}`}>{category}</a>
          ))
        }
      </nav>
    </header>

    <div class="articles-page__list">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</Base>

<style>
  .articles-page {
    padding-block: var(--space-8);
    max-width: 56rem;
    margin-inline: auto;
  }

  .articles-page__header {
    margin-bottom: var(--space-6);
  }

  .articles-page__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .articles-page__filters a {
    text-transform: capitalize;
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
  }

  .articles-page__filters a:hover {
    color: var(--copper);
  }
</style>
