---
// v1.1 redesign: the About page. Built with real content in a prior
// session (src/pages/about.astro's history); this pass is layout-only,
// per instruction — the copy below is byte-for-byte what shipped before,
// not touched.
//
// Layout changes this pass:
// - The hero photo moved from a full-width article-hero treatment into a
//   small corner portrait (320-400px) beside the title/standfirst, since
//   about-hero.jpg is a face-and-shoulders portrait crop, not a landscape
//   photo space — stretching it full-width was the wrong shape for what
//   the photo actually is.
// - A pull-quote card partway through the body, adapting the Reflection
//   essay's pull-quote treatment (olive rule, italic, larger Manrope)
//   into a self-contained elevated card rather than an in-column
//   rule-bordered block.
// - The sign-off is now its own card rather than a plain hairline-divided
//   paragraph — see that style block below for why it deliberately
//   doesn't just reuse <AuthorBox /> as-is.
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { Image } from 'astro:assets';
import { getAuthor } from '../lib/author';
import aboutHero from '../assets/author/about-hero.jpg';

const author = await getAuthor();
---

<Base
  title="About"
  description="Why Cuerpo Coffee exists and who writes it: two decades of paying attention to coffee, starting from a tree on a family plot of land."
>
  <div class="about-band">
    <header class="container about__intro rise-in">
      <div class="about__intro-text">
        <h1>About</h1>
        <p class="about__standfirst">
          Fifteen years old, holding a red coffee cherry I didn't know the name for, on my
          father's land. That's where this started.
        </p>
      </div>
      <div class="about__photo-frame photo-settle">
        <Image
          src={aboutHero}
          alt="Jorge Gomez, founder of Cuerpo Coffee"
          class="about__photo"
          widths={[320, 480, 640]}
          sizes="(min-width: 40rem) 360px, 260px"
          format="avif"
        />
      </div>
    </header>

    <div class="container about__body">
      <Prose>
        <p>
          I've had a cup of coffee every day since I was fourteen. For most of those years,
          that just meant drinking it. It took a coffee tree to make me actually pay
          attention.
        </p>
        <p>
          My father kept a piece of land outside the city — a small weekend house, and a
          much bigger stretch of trees: guava, lemon, apple, berries, mango, orange,
          potatoes, more flowers than I can name. A few coffee trees were mixed in among
          them. I noticed the red cherries on the branches before I understood what they
          were, and once I did, I couldn't leave it alone.
        </p>
        <p>
          My father walked me through the process himself — picking, pulping, drying, the
          parts most people never see because their coffee already arrives as a bag of brown
          beans. I processed my own batch. Then I bought a small roaster and roasted my first
          kilo. I was fifteen.
        </p>

        <div class="about__pullquote">
          <p class="about__pullquote-text">
            A ritual of drinking coffee, a meditation and a time with yourself.
          </p>
        </div>

        <p>
          That's not a story about becoming a professional. I didn't go work for a roaster,
          and I don't have a certification to point to. What I have is closer to twenty years
          of drinking coffee on purpose — comparing beans, changing variables, noticing what
          actually moves a cup from fine to good.
        </p>
        <p>
          Somewhere in there it stopped being about the caffeine. I built a small coffee bar
          in my own house, bought a real espresso machine and the accessories that go with
          it, and turned the first cup of the morning into something closer to a ritual than
          a habit. I don't drink it to wake up anymore. I drink it to slow down before the
          day asks anything of me.
        </p>
        <p>
          That's the whole premise of this site. Not expertise handed down from a café job,
          but two decades of paying attention, starting from a tree I couldn't identify at
          fifteen. If you're standing where I was — curious, slightly obsessed, not sure
          where to start — that's exactly who this is for.
        </p>
      </Prose>

      <div class="about__signoff">
        <p class="about__signoff-name">{author.data.name}</p>
        <p class="about__signoff-title">{author.data.title}</p>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Same "reading body" white band Article.astro's own body sits on —
     About is a reading page, not a section-banded one. */
  .about-band {
    background: var(--surface-1);
    padding-block: var(--space-8);
  }

  /* Wider than the reading column on purpose — a two-column row needs
     more room than the text alone, so this uses .container's own width
     rather than var(--measure). The text side is still capped to
     var(--measure) below, so the title/standfirst don't stretch to fill
     the extra space just because the row is wider. */
  .about__intro {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-7);
    align-items: start;
    margin-bottom: var(--space-8);
  }

  .about__intro-text {
    max-width: var(--measure);
  }

  .about__standfirst {
    font-size: var(--step-1);
    color: var(--espresso);
    margin-top: var(--space-4);
  }

  /* The corner portrait: a fixed small photo, not a full-width hero space
     — about-hero.jpg is a face-and-shoulders crop, the wrong shape for
     the landscape treatment Article.astro's own hero uses. The 4:5 ratio
     and radius live on this wrapping frame, not the <img> itself — Astro's
     <Image> sets the img's HTML width/height attributes to the source
     file's own natural size (1170x1278) since no explicit width/height
     was requested, and confirmed directly (computed styles before/after)
     that a browser resolves the img's rendered box from those attributes
     ahead of a CSS `aspect-ratio` declared on that same element. A plain
     wrapping div has no competing intrinsic size of its own, so the ratio
     and clip apply the same way regardless of that interaction. */
  .about__photo-frame {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .about__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__body {
    max-width: var(--measure);
    margin-inline: auto;
  }

  /* The pull-quote card: docs/DESIGN-SYSTEM.md's pull-quote treatment
     (olive rule, italic, larger Manrope — see ReflectionArticle.astro's
     own blockquote styling) adapted into a self-contained elevated card
     rather than an in-column rule-bordered block, per this session's
     brief. A short centered olive rule stands in for the full-width
     top/bottom rules that treatment normally uses — a rule spanning the
     whole card edge-to-edge would read as a border, not the quote-marker
     accent the olive rule is supposed to be.
     No shadow, deliberately — docs/DESIGN-SYSTEM.md's Shape/space/depth
     section is explicit and has no stated exception: "shadow only on
     hover-lift and the search dropdown, never at rest." This card is
     static, not a link or button, so there's no hover state to hang a
     shadow on either — adding one anyway (or inventing a hover just to
     justify one) would be the kind of one-off exception that erodes a
     restraint rule the moment it's convenient. The card still reads as a
     deliberate pause without one: a different surface color, generous
     padding, and rounded corners already separate it from the paragraphs
     around it, the same way every other at-rest card on this site (the
     author box, a pillar tile, the newsletter card) achieves elevation
     without a shadow. */
  .about__pullquote {
    /* margin-bottom only — this div is a direct child of <Prose>, so
       Prose's own `.prose > * + *` rule already gives it a margin-top;
       adding one here too would stack the two, the exact bug class
       flagged repeatedly elsewhere in this codebase. */
    background: var(--surface-2);
    border-radius: var(--radius-lg);
    padding: var(--space-7) var(--space-6);
    margin-bottom: var(--space-8);
    text-align: center;
  }

  .about__pullquote::before {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    background: var(--olive-text);
    margin-inline: auto;
    margin-bottom: var(--space-4);
  }

  .about__pullquote-text {
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--ink);
    max-width: 32ch;
    margin-inline: auto;
  }

  /* The closing sign-off, its own card — not a reuse of <AuthorBox />.
     AuthorBox's whole job is to introduce the author on someone else's
     reading (an article they didn't write); here the author IS the page,
     and the portrait photo already ran at the top of it, so a second
     small circular avatar here would just be a duplicate, not a closing
     moment. Deliberately text-only: name, then title, centered, in the
     same surface-2/radius-lg card language as the pull-quote above it so
     the two read as siblings — the page's two "pause" moments — without
     being the same component. Same "padding instead of a second
     margin-top" reasoning as the plain-paragraph version this replaced:
     Prose's `.prose > * + *` rule only reaches its own direct children,
     and this card sits in .about__body as Prose's sibling (not inside
     Prose), so it never had that stacked-margin risk to begin with —
     its own margin-top here is the only one in play. */
  .about__signoff {
    background: var(--surface-2);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-top: var(--space-8);
    text-align: center;
  }

  .about__signoff-name {
    font-weight: 700;
    font-size: var(--step-1);
  }

  .about__signoff-title {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--space-2);
  }

  @media (max-width: 40rem) {
    /* Stacked, not full-width: the photo keeps its own modest size and
       centers above the text, rather than growing to fill the mobile
       viewport the way a real hero photo space would. */
    .about__intro {
      grid-template-columns: 1fr;
    }

    .about__intro-text {
      order: 2;
    }

    .about__photo-frame {
      order: 1;
      width: 13rem;
      margin-inline: auto;
    }
  }
</style>
