---
export interface Props {
  title: string;
  description: string;
  image?: string;
  articleMeta?: {
    publishDate: Date;
    updatedDate?: Date;
  };
  // Session 5: Reflection essays open dark by default, regardless of
  // system preference — the one exception to the site-wide "follow
  // prefers-color-scheme unless the visitor already chose" rule. Passed
  // through from Base.astro, which is the only place that sets it (via
  // ReflectionArticle.astro). Still fully overridable: an explicit
  // cuerpo_theme='light' in localStorage (the visitor clicking the
  // toggle) always wins over this.
  forceDark?: boolean;
}

const { title, description, image, articleMeta, forceDark = false } = Astro.props;

const siteName = 'Cuerpo Coffee';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;

// The forceDark flag is baked into the minified script text below as a
// literal `true`/`false` at build time (via set:html) rather than read
// from a data-attribute at runtime — one fewer DOM read on every page
// load, and it means this page's actual resolved default is visible
// directly in its own HTML source, not just implied by a prop.
const themeScript = `(function(){try{var t=localStorage.getItem('cuerpo_theme'),d=t?t==='dark':(${forceDark}||matchMedia('(prefers-color-scheme: dark)').matches);if(d)document.documentElement.dataset.theme='dark'}catch(e){}})();`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<title>{fullTitle}</title>
<meta name="description" content={description} />

<link
  rel="preload"
  href="/fonts/manrope-variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/fraunces-variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

{/*
  Sets the theme before first paint so there's no flash of the wrong
  theme. is:inline means Astro ships this byte-for-byte, uncompressed —
  hand-minified rather than written readably, to stay well under the 1 KB
  budget for the whole dark-mode feature (measured: 199 bytes here on a
  normal page, up from 191 in session 2 — the `(${forceDark}||...)` wrapper
  costs 8 extra bytes on every page, not just Reflection ones, since the
  script text has to be able to say `false` explicitly. 442 in
  Header.astro's click handler, unchanged; 641 combined on a normal page).
  See Header.astro for the other half — same logic, unminified, for
  reference:

    (function () {
      try {
        var stored = localStorage.getItem('cuerpo_theme');
        var forceDark = false; // baked in per-page by BaseHead's forceDark prop
        var dark = stored
          ? stored === 'dark'
          : forceDark || matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    })();
*/}
<script is:inline set:html={themeScript} />

<meta property="og:type" content={articleMeta ? 'article' : 'website'} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
{ogImage && <meta property="og:image" content={ogImage} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{
  articleMeta && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        ...(ogImage ? { image: ogImage } : {}),
        datePublished: articleMeta.publishDate.toISOString(),
        dateModified: (articleMeta.updatedDate ?? articleMeta.publishDate).toISOString(),
        publisher: {
          '@type': 'Organization',
          name: siteName,
        },
      })}
    />
  )
}
