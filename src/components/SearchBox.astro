---
// v1.1 session 5: search, via Pagefind (built at deploy time over the
// article content — see package.json's "postbuild" script and Article.
// astro/ReflectionArticle.astro's data-pagefind-body/-ignore attributes
// for what actually gets indexed). No client filtering of categories or
// tags here — those stay the static links already built in session 4;
// this is free-text search only.
//
// Pagefind's own JS (~a few hundred KB, scales with index size) is
// genuinely heavy, so it's never loaded on page load — only on the first
// focus or keystroke in this field, via a dynamic import(). The small
// wiring script below (which just knows *when* to trigger that import)
// always loads; the actual Pagefind runtime does not, until interaction.
---

<div class="search">
  <label for="search-input" class="visually-hidden">Search articles</label>
  <input
    type="search"
    id="search-input"
    class="search__input"
    placeholder="Search articles"
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-controls="search-results"
    aria-autocomplete="list"
  />
  <div id="search-results" class="search__results" role="listbox" hidden></div>
</div>

{/*
  Unminified for reference:

    (function () {
      var input = document.getElementById('search-input');
      var results = document.getElementById('search-results');
      if (!input || !results) return;

      var pagefindPromise;
      function loadPagefind() {
        if (!pagefindPromise) {
          // Fails harmlessly in `astro dev`/before a build has run
          // Pagefind's own indexing step — there's no /pagefind/ output
          // until then.
          pagefindPromise = import('/pagefind/pagefind.js')
            .then(function (mod) {
              return mod.init().then(function () {
                return mod;
              });
            })
            .catch(function () {
              return null;
            });
        }
        return pagefindPromise;
      }

      function clear() {
        results.innerHTML = '';
        results.hidden = true;
        results.classList.remove('is-visible');
        input.setAttribute('aria-expanded', 'false');
      }

      function show() {
        results.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        // Next frame, so the opacity transition actually runs from the
        // hidden state instead of jumping straight to visible.
        requestAnimationFrame(function () {
          results.classList.add('is-visible');
        });
      }

      var currentTerm = '';

      async function runSearch(term) {
        currentTerm = term;
        if (!term) {
          clear();
          return;
        }
        var pagefind = await loadPagefind();
        if (!pagefind || currentTerm !== term) return;
        var search = await pagefind.debouncedSearch(term);
        if (!search || currentTerm !== term) return;
        var items = await Promise.all(search.results.slice(0, 8).map(function (r) {
          return r.data();
        }));
        if (currentTerm !== term) return;
        if (items.length === 0) {
          results.innerHTML = '<p class="search__empty">No results.</p>';
        } else {
          results.innerHTML = items
            .map(function (item) {
              return (
                '<a class="search__result" href="' + item.url + '">' +
                '<span class="search__result-title">' + item.meta.title + '</span>' +
                '<span class="search__result-excerpt">' + item.excerpt + '</span>' +
                '</a>'
              );
