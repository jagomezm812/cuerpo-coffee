              ' href="' + item.url + '">' +
              category +
              '<p class="search__result-title">' + item.title + '</p>' +
              '<p class="search__result-excerpt">' + item.excerpt + '</p>' +
              '</a>'
            );
          })
          .join('');
        show();
      }

      function setActive(i) {
        if (items.length === 0) return;
        activeIndex = Math.max(0, Math.min(i, items.length - 1));
        renderItems();
