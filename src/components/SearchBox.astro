      var currentTerm = '';

      async function runSearch(term) {
        currentTerm = term;
        if (!term) {
          clear();
          return;
        }
        var pagefind = await loadPagefind();
        if (!pagefind || currentTerm !== term) return;
        var search = await pagefind.debouncedSearch(term);
        if (!search || currentTerm !== term) return;
        // 5: a sensible visible-results count (the brief's 4-6 range),
        // not Pagefind's own much larger default result count.
        var data = await Promise.all(search.results.slice(0, 5).map(function (r) {
          return r.data();
        }));
        if (currentTerm !== term) return;
        items = data.map(function (d) {
          return { title: d.meta.title, excerpt: d.excerpt, url: d.url, category: d.meta.category };
        });
        activeIndex = -1;
        renderItems();
      }

      input.addEventListener('focus', loadPagefind, { once: true });
      input.addEventListener('input', function () {
        runSearch(input.value.trim());
      });
      document.addEventListener('click', function (e) {
        if (e.target !== input && !results.contains(e.target)) clear();
      });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          clear();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(activeIndex + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(activeIndex - 1);
        } else if (e.key === 'Enter') {
          // No arrow-key selection yet (just typed and hit Enter)? Go to
          // the top result, the common "search box" expectation.
          var idx = activeIndex >= 0 ? activeIndex : 0;
          if (items[idx]) {
            e.preventDefault();
            location.href = items[idx].url;
          }
        }
      });

      // Header.astro's search button links here with ?focus=search.
      if (new URLSearchParams(location.search).get('focus') === 'search') {
        input.focus();
      }
    })();
*/}
