---
export interface Props {
  lang?: 'en' | 'es';
  otherLangHref?: string;
}

const { lang = 'en', otherLangHref = lang === 'es' ? '/' : '/es/articles' } = Astro.props;

function withSetLang(href: string, target: 'en' | 'es'): string {
  return `${href}${href.includes('?') ? '&' : '?'}setlang=${target}`;
}

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p>&copy; {year} Cuerpo Coffee</p>
    <nav aria-label="Footer">
      <ul class="site-footer__links">
        <li><a href="/articles">Articles</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>
    <p class="site-footer__lang" aria-label="Language">
      {
        lang === 'en' ? (
          <span aria-current="true">English</span>
        ) : (
          <a href={withSetLang(otherLangHref, 'en')}>English</a>
        )
      }
      <span aria-hidden="true"> · </span>
      {
        lang === 'es' ? (
          <span aria-current="true">Español</span>
        ) : (
          <a href={withSetLang(otherLangHref, 'es')}>Español</a>
        )
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-9);
  }

  .site-footer__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-6);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .site-footer__links {
    display: flex;
    list-style: none;
    gap: var(--space-4);
    padding: 0;
  }

  .site-footer__links a {
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--copper);
  }

  .site-footer__lang {
    display: flex;
    gap: var(--space-1);
  }

  .site-footer__lang a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-footer__lang a:hover {
    color: var(--copper);
  }

  .site-footer__lang span[aria-current] {
    color: var(--espresso);
  }
</style>
