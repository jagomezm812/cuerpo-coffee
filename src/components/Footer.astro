---
// Language switcher: links to the dedicated /set-language path
// (worker/index.ts) rather than appending ?setlang= to whatever page
// you're already on — see wrangler.jsonc's run_worker_first comment for
// why that change mattered (it's what let run_worker_first go back to a
// short explicit list instead of every single request).
export interface Props {
  lang?: 'en' | 'es';
  otherLangHref?: string;
}

const { lang = 'en', otherLangHref = lang === 'es' ? '/' : '/es/articles' } = Astro.props;

function setLanguageHref(target: 'en' | 'es', destination: string): string {
  return `/set-language?to=${target}&href=${encodeURIComponent(destination)}`;
}

const year = new Date().getFullYear();

// Only pages that exist today, same reasoning as Header.astro.
const readLinks = [{ href: '/articles', label: 'Articles' }];
const cuerpoLinks = [
  { href: '/about', label: 'About' },
  { href: '/subscribe', label: 'Subscribe' },
];
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <p class="site-footer__wordmark">Cuerpo Coffee</p>
      <p class="site-footer__description">
        Make good coffee at home. No gear obsession, no jargon.
      </p>
    </div>
    <nav aria-label="Read" class="site-footer__column">
      <p class="site-footer__heading">Read</p>
      <ul>
        {readLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="Cuerpo" class="site-footer__column">
      <p class="site-footer__heading">Cuerpo</p>
      <ul>
        {cuerpoLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {year} Cuerpo Coffee</p>
    <p class="site-footer__lang" aria-label="Language">
      {
        lang === 'en' ? (
          <span aria-current="true">English</span>
        ) : (
          <a href={setLanguageHref('en', otherLangHref)}>English</a>
        )
      }
      <span aria-hidden="true"> · </span>
      {
        lang === 'es' ? (
          <span aria-current="true">Español</span>
        ) : (
          <a href={setLanguageHref('es', otherLangHref)}>Español</a>
        )
      }
    </p>
  </div>

  <p class="site-footer__giant" aria-hidden="true">Cuerpo</p>
</footer>

<style>
  /* --footer is one of the "always-dark blocks" in docs/DESIGN-SYSTEM.md —
     it stays dark in both themes, unlike the rest of the page. Text tokens
     here are therefore always the *-on-dark set, not --ink/--muted, which
     would go the wrong direction under light mode. */
  .site-footer {
    position: relative;
    overflow: hidden;
    margin-top: var(--space-9);
    background: var(--footer);
    color: var(--ink-on-dark);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-6);
  }

  .site-footer__wordmark {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  .site-footer__description {
    color: var(--muted-on-dark);
    max-width: 32ch;
  }

  .site-footer__heading {
    /* Footer-only: these need to actually function as the heading for
       their column (there's no bigger heading below them here), unlike
       the shared small-uppercase-label pattern used elsewhere on the site
       (Start here, Series, Newsletter), which sits above a much bigger
       heading and stays small on purpose. This is a local override in
       Footer.astro's own scoped styles, not a change to that shared
       pattern. Bumped from --step--1 (smaller than the links below it —
       the "backwards" hierarchy) to --step-1, clearly larger than the
       links' own explicit --step--1. */
    font-size: var(--step-1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--olive-on-dark);
    margin-bottom: var(--space-4);
  }

  .site-footer__column ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__column a {
    font-size: var(--step--1);
    color: var(--ink-on-dark);
    text-decoration: none;
  }

  .site-footer__column a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-top: 1px solid rgba(243, 234, 223, 0.12);
    color: var(--muted-on-dark);
    font-size: var(--step--1);
  }

  .site-footer__lang {
    display: flex;
    gap: var(--space-1);
  }

  .site-footer__lang a {
    color: var(--muted-on-dark);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-footer__lang a:hover {
    color: var(--ink-on-dark);
  }

  .site-footer__lang span[aria-current] {
    color: var(--ink-on-dark);
  }

  .site-footer__giant {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(4rem, 18vw, 12rem);
    line-height: 1;
    color: var(--ink-on-dark);
    opacity: 0.06;
    text-align: center;
    white-space: nowrap;
    margin-top: var(--space-6);
    margin-bottom: calc(-1 * var(--space-8));
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
