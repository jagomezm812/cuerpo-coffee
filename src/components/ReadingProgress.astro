---
// The reading-progress line — docs/DESIGN-SYSTEM.md lists this explicitly
// as an olive section marker. This genuinely needs client JS (there's no
// reliable, baseline cross-browser CSS-only way to tie a fixed bar's width
// to scroll position through an arbitrary element yet), so it's hand-
// minified is:inline like every other small script in this project, and
// verified with `node -c` before trusting it. Tracks scroll through
// whichever element in the page carries `data-reading-progress-target`
// (the article's own wrapper, see Article.astro).
---

<div class="reading-progress-track" aria-hidden="true">
  <div id="reading-progress" class="reading-progress-bar"></div>
</div>

{/*
  Unminified for reference:

    (function () {
      var bar = document.getElementById('reading-progress');
      var target = document.querySelector('[data-reading-progress-target]');
      if (!bar || !target) return;
      function update() {
        var rect = target.getBoundingClientRect();
        var total = rect.height - window.innerHeight;
        var scrolled = -rect.top;
        var pct = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0;
        bar.style.width = pct + '%';
      }
      document.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
*/}
<script is:inline>(function(){var b=document.getElementById('reading-progress'),t=document.querySelector('[data-reading-progress-target]');if(!b||!t)return;function u(){var r=t.getBoundingClientRect(),tot=r.height-window.innerHeight,sc=-r.top,p=tot>0?Math.min(100,Math.max(0,sc/tot*100)):0;b.style.width=p+'%'}document.addEventListener('scroll',u,{passive:true});window.addEventListener('resize',u);u()})();</script>

<style>
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 60;
    background: transparent;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--olive);
  }
</style>
