---
export interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Get one good coffee idea a week.',
  body = 'No spam, no upsells in every email. Just what actually improves the cup.',
} = Astro.props;
---

<section class="email-capture">
  {heading && <h2>{heading}</h2>}
  {body && <p>{body}</p>}
  <form class="email-capture__form">
    <label for="email-capture-input" class="visually-hidden">Email address</label>
    <input
      id="email-capture-input"
      type="email"
      name="email"
      placeholder="you@example.com"
      required
    />
    <button type="submit">Subscribe</button>
  </form>
  <p class="email-capture__message" hidden></p>
</section>

<script>
  // Handles every .email-capture__form on the page, including ones that
  // aren't Astro component instances — the mid-article placement is raw
  // HTML injected by remark-inline-subscribe.mjs, sharing this same class
  // structure so one script covers both. Astro dedupes this script across
  // multiple EmailCapture instances on one page, so it ships once regardless
  // of how many forms are present.
  function initEmailCaptureForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('.email-capture__form');

    forms.forEach((form) => {
      if (form.dataset.emailCaptureBound) return;
      form.dataset.emailCaptureBound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const input = form.querySelector<HTMLInputElement>('input[type="email"]');
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const messageEl = form.parentElement?.querySelector<HTMLElement>('.email-capture__message');
        const email = input?.value.trim() ?? '';

        if (!email) return;
        if (button) button.disabled = true;

        try {
          const response = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          const data = await response.json();

          if (response.ok && data.ok) {
            form.hidden = true;
            if (messageEl) {
              messageEl.hidden = false;
              messageEl.textContent = "You're subscribed — thanks!";
            }
          } else {
            throw new Error('subscribe failed');
          }
        } catch {
          if (messageEl) {
            messageEl.hidden = false;
            messageEl.textContent = 'Something went wrong — please try again in a moment.';
          }
          if (button) button.disabled = false;
        }
      });
    });
  }

  initEmailCaptureForms();
</script>
