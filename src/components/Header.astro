---
const links = [
  { href: '/articles', label: 'Articles' },
  { href: '/about', label: 'About' },
  { href: '/subscribe', label: 'Subscribe' },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="wordmark">Cuerpo Coffee</a>
    <nav aria-label="Primary">
      <ul class="site-header__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .wordmark {
    /* v1.1: Fraunces is reserved for the page H1 only (docs/DESIGN-SYSTEM.md).
       The wordmark moves to Manrope at weight 800, per section 6 of
       docs/TECHNICAL-PLAN.md ("the wordmark 800"). */
    font-family: var(--font-body);
    font-weight: 800;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--copper);
  }

  .site-header__links {
    display: flex;
    list-style: none;
    gap: var(--space-5);
    padding: 0;
  }

  .site-header__links a {
    text-decoration: none;
    font-weight: 500;
    color: var(--espresso);
  }

  .site-header__links a:hover {
    color: var(--copper);
  }
</style>
