---
// Only pages that exist today. Start here and Series still join this list
// in a later session, once those pages exist — docs/DESIGN-SYSTEM.md's
// full header anatomy (wordmark, four links, search, toggle, Subscribe) is
// the eventual target, not today's build. Search itself was added this
// session (below), so it's no longer on that "not yet built" list.
// Rendered twice below (desktop inline nav + mobile drawer) from this one
// array, so there's no risk of the two falling out of sync.
const links = [
  { href: '/articles', label: 'Articles' },
  { href: '/about', label: 'About' },
];

// Session 6: the header search button links to the Explore page's own
// SearchBox with a query param that tells it to auto-focus on load — see
// SearchBox.astro's script for the other half of this. A query param, not
// just a plain /articles link, since a fragment/anchor alone wouldn't
// actually focus the field.
const searchHref = '/articles?focus=search';
---

<header class="site-header">
  <div class="container site-header__row">
    <button
      type="button"
      id="menu-toggle"
      class="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="menu-toggle__icon menu-toggle__icon--open" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg class="menu-toggle__icon menu-toggle__icon--close" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <a href="/" class="wordmark">
      <span class="wordmark__cuerpo">Cuerpo</span> <span class="wordmark__coffee">Coffee</span>
    </a>

    <div class="site-header__actions">
      <nav aria-label="Primary" class="site-header__nav">
        <ul class="site-header__links">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Switch to dark theme"
        aria-pressed="false"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M20.5 14.5a8.5 8.5 0 1 1-9-13 7 7 0 0 0 9 13Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6" />
          <path
            d="M12 2.5v2.5M12 19v2.5M4.4 4.4l1.8 1.8M17.8 17.8l1.8 1.8M2.5 12H5M19 12h2.5M4.4 19.6l1.8-1.8M17.8 6.2l1.8-1.8"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </button>
      <a href="/subscribe" class="subscribe-button">Subscribe</a>
      {/* Plain navigation, no click handler needed — SearchBox.astro's own
         script reads ?focus=search on load and focuses the field itself.
         Hidden on mobile (see the media query below): it moves into the
         drawer instead of becoming a fourth icon in an already-tight
         mobile header row. */}
      <a href={searchHref} class="header-search-button" aria-label="Search articles">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" />
          <path d="M20 20l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </a>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Primary" hidden>
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
      <li>
        {/* Sensible spot per the session brief: grouped with the other
           navigation links, not down with the theme toggle (which was
           deliberately placed last, in an earlier session, as the
           drawer's final row) and not a bare icon here — this is the one
           place on the whole site an icon-only search control would have
           no adjacent visible label at all. */}
        <a href={searchHref} class="mobile-search-link">
          <svg class="mobile-search-link__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.6" />
            <path d="M20 20l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
          Search
        </a>
      </li>
      <li>
        <button type="button" id="theme-toggle-mobile" class="mobile-theme-toggle">
          <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M20.5 14.5a8.5 8.5 0 1 1-9-13 7 7 0 0 0 9 13Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6" />
            <path
              d="M12 2.5v2.5M12 19v2.5M4.4 4.4l1.8 1.8M17.8 17.8l1.8 1.8M2.5 12H5M19 12h2.5M4.4 19.6l1.8-1.8M17.8 6.2l1.8-1.8"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
          {/* Text-driven, not JS-driven — two spans, CSS shows whichever
              matches the current [data-theme], same pattern as the icons.
              No aria-label needed: with no other visible text, the
              button's accessible name already comes from whichever span
              is showing ("Dark mode" / "Light mode"), which correctly
              names the action a click performs. */}
          <span class="mobile-theme-toggle__label mobile-theme-toggle__label--to-dark">Dark mode</span>
          <span class="mobile-theme-toggle__label mobile-theme-toggle__label--to-light">Light mode</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

{/*
  Click handler for the dark-mode toggle. Hand-minified like
  BaseHead.astro's script (is:inline ships both byte-for-byte) —
  unminified for reference:

    (function () {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var html = document.documentElement;
      function sync(dark) {
        btn.setAttribute('aria-pressed', dark);
        btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      }
      // BaseHead.astro's <head> script may already have set data-theme
      // before this button was even parsed — sync the button's ARIA state
      // to match on load, rather than assuming it always starts light.
      sync(html.dataset.theme === 'dark');
      btn.onclick = function () {
        var dark = html.dataset.theme !== 'dark';
        if (dark) html.dataset.theme = 'dark';
        else delete html.dataset.theme;
        sync(dark);
        try {
          localStorage.setItem('cuerpo_theme', dark ? 'dark' : 'light');
        } catch (e) {}
      };
    })();
*/}
<script is:inline>(function(){var b=document.getElementById('theme-toggle');if(!b)return;var e=document.documentElement;function s(d){b.setAttribute('aria-pressed',d);b.setAttribute('aria-label',d?'Switch to light theme':'Switch to dark theme')}s(e.dataset.theme==='dark');b.onclick=function(){var d=e.dataset.theme!=='dark';if(d)e.dataset.theme='dark';else delete e.dataset.theme;s(d);try{localStorage.setItem('cuerpo_theme',d?'dark':'light')}catch(x){}}})();</script>

{/*
  Mobile menu open/close. No client-side routing on this static site, so
  clicking a link inside the drawer navigates to a new page and the drawer
  naturally resets to closed — no extra close-on-navigate logic needed.
  Unminified for reference:

    (function () {
      var btn = document.getElementById('menu-toggle');
      var menu = document.getElementById('mobile-menu');
      if (!btn || !menu) return;
      btn.onclick = function () {
        var open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
        menu.hidden = open;
      };
    })();
*/}
<script is:inline>(function(){var b=document.getElementById('menu-toggle'),m=document.getElementById('mobile-menu');if(!b||!m)return;b.onclick=function(){var o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));b.setAttribute('aria-label',o?'Open menu':'Close menu');m.hidden=o}})();</script>

{/*
  Click handler for the mobile-menu's dark-mode toggle row. Simpler than
  the desktop button's script: no aria-pressed/aria-label sync needed,
  since this button's accessible name already comes from its visible
  text label ("Dark mode"/"Light mode"), which is CSS-driven off
  [data-theme] exactly like the icons — nothing here needs to run on
  load, only on click. Unminified for reference:

    (function () {
      var btn = document.getElementById('theme-toggle-mobile');
      if (!btn) return;
      var html = document.documentElement;
      btn.onclick = function () {
        var dark = html.dataset.theme !== 'dark';
        if (dark) html.dataset.theme = 'dark';
        else delete html.dataset.theme;
        try {
          localStorage.setItem('cuerpo_theme', dark ? 'dark' : 'light');
        } catch (e) {}
      };
    })();
*/}
<script is:inline>(function(){var b=document.getElementById('theme-toggle-mobile'),e=document.documentElement;if(!b)return;b.onclick=function(){var d=e.dataset.theme!=='dark';if(d)e.dataset.theme='dark';else delete e.dataset.theme;try{localStorage.setItem('cuerpo_theme',d?'dark':'light')}catch(x){}}})();</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--hairline);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-4);
  }

  .wordmark {
    font-family: var(--font-body);
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark__cuerpo {
    font-weight: 800;
  }

  .wordmark__coffee {
    font-weight: 400;
  }

  .wordmark:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .site-header__links {
    display: flex;
    list-style: none;
    gap: var(--space-5);
    padding: 0;
  }

  .site-header__links a {
    text-decoration: none;
    font-weight: 600;
    color: var(--ink);
  }

  .site-header__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .theme-toggle,
  .menu-toggle,
  .header-search-button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .menu-toggle:hover,
  .header-search-button:hover {
    border-color: var(--ink);
  }

  .theme-toggle__icon,
  .menu-toggle__icon,
  .header-search-button svg {
    width: 18px;
    height: 18px;
  }

  /* Only one icon shows at a time in each toggle — CSS-driven off
     [data-theme]/[aria-expanded], no JS needed for the icon swap itself. */
  .theme-toggle__icon--sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__icon--moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: block;
  }

  .menu-toggle__icon--close {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--close {
    display: block;
  }

  /* Desktop default: no hamburger, links shown inline, drawer never shown. */
  .menu-toggle {
    display: none;
  }

  .mobile-menu {
    display: none;
  }

  .subscribe-button {
    /* Design system Buttons component: height 52px, pill, Manrope 600 at
       15px. --step--1 (14-15px) is the closest existing token to a literal
       15px — kept token-based rather than a hardcoded magic number, per
       the project's "tokens only" rule. */
    display: inline-flex;
    align-items: center;
    height: 52px;
    padding-inline: var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--button-bg);
    color: var(--button-fg);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
    transition: transform 200ms ease;
  }

  .subscribe-button:hover {
    transform: translateY(-1px);
  }

  /* Mobile: hamburger (left) / wordmark (center) / Subscribe (right). The
     round dark-mode toggle does NOT appear in this row on mobile at all —
     it moves into the drawer itself (see .mobile-theme-toggle below),
     styled as a labeled row rather than an icon-only button. Desktop is
     untouched: .theme-toggle keeps showing there exactly as before. */
  @media (max-width: 40rem) {
    .site-header__row {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
    }

    .menu-toggle {
      display: grid;
    }

    .wordmark {
      justify-self: center;
      text-align: center;
    }

    .site-header__nav {
      display: none;
    }

    .theme-toggle,
    .header-search-button {
      display: none;
    }

    .site-header__actions {
      justify-self: end;
      gap: var(--space-3);
    }

    .subscribe-button {
      height: 40px;
      padding-inline: var(--space-4);
    }

    .mobile-menu:not([hidden]) {
      display: block;
      /* Same horizontal rhythm as the rest of the page — .container
         (used everywhere else) sets this same --space-5 side padding;
         the drawer isn't wrapped in .container, so it needs its own. */
      padding-inline: var(--space-5);
      padding-block: var(--space-4);
      border-top: 1px solid var(--hairline);
    }

    .mobile-menu ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .mobile-menu a {
      text-decoration: none;
      font-weight: 600;
      color: var(--ink);
    }

    /* Same icon+label row shape as .mobile-theme-toggle below, so the two
       rows read as one consistent pattern in the drawer — just an <a>
       instead of a <button>, since this one is plain navigation. */
    .mobile-search-link {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    .mobile-search-link__icon {
      width: 18px;
      height: 18px;
    }

    .mobile-theme-toggle {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      padding: 0;
      border: none;
      background: none;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: var(--step-0);
      color: var(--ink);
      cursor: pointer;
    }

    .mobile-theme-toggle .theme-toggle__icon {
      width: 18px;
      height: 18px;
    }

    /* Label text is CSS-driven off [data-theme], exactly like the icons —
       no JS needed to pick which one shows. */
    .mobile-theme-toggle__label--to-light {
      display: none;
    }

    :global([data-theme='dark']) .mobile-theme-toggle__label--to-dark {
      display: none;
    }

    :global([data-theme='dark']) .mobile-theme-toggle__label--to-light {
      display: inline;
    }
  }
</style>
