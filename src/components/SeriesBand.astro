---
// The Series band from docs/DESIGN-SYSTEM.md ("surface-3", up to two series
// cards). Built now per the session 3 instruction, but there is no series
// data model yet (that lands in session 4 alongside the article template),
// so index.astro always passes an empty array today — this component
// renders nothing in that case, the same "hidden when there's nothing to
// show" mechanism as the Reflection strip, rather than a special case.
export interface Props {
  series: Array<{
    title: string;
    description: string;
    href: string;
    articleCount: number;
  }>;
}

const { series } = Astro.props;
---

{
  series.length > 0 && (
    <section class="series-band">
      <div class="container series-band__inner">
        <p class="section-label">Series</p>
        <h2>Read in order</h2>
        <div class="series-band__cards">
          {series.slice(0, 2).map((s) => (
            <a href={s.href} class="series-card">
              <h3 class="series-card__title">{s.title}</h3>
              <p class="series-card__description">{s.description}</p>
              <span class="series-card__count">{s.articleCount} articles</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .series-band {
    background: var(--surface-3);
    padding-block: var(--space-9);
  }

  .series-band__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .series-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--surface-card);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 280ms ease,
      box-shadow 280ms ease;
  }

  .series-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .series-card__title {
    font-size: var(--step-1);
  }

  .series-card__description {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .series-card__count {
    margin-top: auto;
    color: var(--olive-text);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  @media (max-width: 40rem) {
    .series-band__cards {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .series-card {
      transition: none;
    }
  }
</style>
