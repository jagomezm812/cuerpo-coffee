---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LanguagePrompt from '../components/LanguagePrompt';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  articleMeta?: {
    publishDate: Date;
    updatedDate?: Date;
  };
  bare?: boolean;
  // Site chrome (Header/Footer nav labels, About, Subscribe) stays
  // English-only for now — only the Article layout ever passes lang="es"
  // or a real otherLangHref, for the one page type that actually has
  // translated content. Footer's language switcher and the language
  // prompt both consume otherLangHref, just in different directions.
  lang?: 'en' | 'es';
  otherLangHref?: string;
}

const {
  title,
  description,
  image,
  articleMeta,
  bare = false,
  lang = 'en',
  otherLangHref,
} = Astro.props;

// No Spanish homepage exists yet (chrome is English-only), so the default
// Spanish target is the Spanish article index — the only page that's
// actually meaningful in that direction. Explicit prop (set by Article.astro
// via getTranslationHref, in either direction) overrides this whenever a
// real per-article translation link applies.
const resolvedOtherLangHref = otherLangHref ?? (lang === 'es' ? '/' : '/es/articles');
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} articleMeta={articleMeta} />
  </head>
  <body>
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    {!bare && <Footer lang={lang} otherLangHref={resolvedOtherLangHref} />}
    <LanguagePrompt client:idle currentLang={lang} spanishHref={resolvedOtherLangHref} />
  </body>
</html>
