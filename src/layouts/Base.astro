---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  articleMeta?: {
    publishDate: Date;
    updatedDate?: Date;
  };
  bare?: boolean;
}

const { title, description, image, articleMeta, bare = false } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} articleMeta={articleMeta} />
  </head>
  <body>
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
